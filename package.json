{
  "name": "browsersdr",
  "version": "1.3.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check eslint.config.js vitest.config.ts playwright.config.ts \"e2e/**/*.ts\" .github/workflows/ci.yml package.json .prettierrc.json",
    "wasm:build": "./scripts/build-wasm.sh",
    "usrp:driver:build": "./scripts/build-usrp-b205-no-os.sh",
    "test:wasm": "vitest run src/dsp/spectrumBackend.test.ts --reporter=verbose",
    "test:atlas-contract": "vitest run src/radio/atlasSigmfCompatibility.test.ts src/radio/sigmf.test.ts src/radio/sigmfImport.test.ts",
    "test:atlas-transfer": "vitest run src/radio/atlasTransfer.test.ts src/radio/atlasSigmfCompatibility.test.ts",
    "test:atlas-transfer:real": "vitest run src/radio/atlasTransfer.real.test.ts",
    "test:atlas-workflow": "vitest run src/ui/AtlasSavePanel.test.tsx src/radio/atlasTransfer.test.ts src/radio/atlasSigmfCompatibility.test.ts && playwright test --grep SigIntAtlas",
    "test:atlas-workflow:real": "vitest run src/radio/atlasWorkflow.real.test.ts",
    "fixtures:atlas": "BSD01_UPDATE_FIXTURES=1 vitest run src/radio/atlasSigmfCompatibility.test.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --project=chromium-dev",
    "test:e2e:production": "playwright test --project=chromium-production",
    "test:report-service": "node --test deploy/report-service/report-service-tests.mjs scripts/community-evidence-fingerprint-tests.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run public:check && npm run lint && npm run format:check && npm run test:wasm && npm run test:report-service && npm test && npm run build && npm run performance:check && npm run test:e2e",
    "public:check": "node scripts/check-public-source.mjs",
    "performance:check": "node scripts/check-performance.mjs"
  },
  "dependencies": {
    "@jtarrio/signals": "0.10.1",
    "@jtarrio/webrtlsdr": "3.0.6",
    "@noble/hashes": "^2.4.0",
    "fflate": "0.8.3",
    "lucide-react": "1.52.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.72",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
